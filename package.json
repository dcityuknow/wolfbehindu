{
  "name": "lost-island-fhe",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/run.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "compile": "node scripts/deploy.mjs --compile-only",
    "deploy": "node scripts/deploy.mjs",
    "test": "npm --prefix hh install --legacy-peer-deps --no-audit --no-fund && npm --prefix hh test"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fhevm/solidity": "^0.13.4",
    "@openzeppelin/confidential-contracts": "^0.5.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/three": "^0.170.0",
    "dotenv": "^16.4.5",
    "encrypted-types": "^0.0.4",
    "solc": "0.8.27",
    "typescript": "5.6",
    "vite": "5.4"
  }
}
